{
  "name": "source",
  "version": "0.2.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "create-react-app": "^5.1.0",
    "cross-env": "^10.0.0",
    "history": "^5.3.0",
    "husky": "^9.1.7",
    "jest-junit": "^16.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.1",
    "react-scripts": "^5.0.1",
    "typescript": "^4.9.5"
  },
  "overrides": {
    "tar": "^6.2.1",
    "rimraf": "^6.0.1",
    "glob": "^11.0.3",
    "nth-check": "^2.0.1",
    "test-exclude": "^7.0.1"
  },
  "scripts": {
    "start": "PORT=8080 react-scripts start",
    "prebuild": "rm -rf build",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "lint": "eslint src/**/*.js src/**/*.jsx",
    "clean": "rm -rf node_modules build dest coverage",
    "pretest:ci": "rm -rf dest coverage",
    "test:ci": "cross-env CI=true react-scripts test --coverage --testResultsProcessor ./node_modules/jest-sonar-reporter/index.js",
    "posttest:ci": "cross-env CI=true react-scripts test --reporters=default --reporters=jest-junit",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/index.js",
      "!src/serviceWorker.js",
      "!src/setupTests.js",
      "!<rootDir>/node_modules/",
      "!<rootDir>/path/to/dir/"
    ],
    "coverageReporters": [
      "lcov",
      "cobertura"
    ]
  },
  "jest-junit": {
    "outputDirectory": "dest",
    "outputName": "test-results.xml"
  },
  "jestSonar": {
    "reportPath": "dest",
    "reportFile": "test-sonar-results.xml",
    "indent": 4
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
